{
  "name": "kinsite",
  "version": "0.2.0",
  "type": "module",
  "description": "Static HTML family-tree site from a GEDCOM file",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrismo/kinsite.git"
  },
  "homepage": "https://github.com/chrismo/kinsite#readme",
  "bugs": {
    "url": "https://github.com/chrismo/kinsite/issues"
  },
  "keywords": [
    "gedcom",
    "genealogy",
    "family-tree",
    "static-site"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/",
    "build.mjs"
  ],
  "bin": {
    "kinsite": "build.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "sample": "node build.mjs sample/kinsite.config.json",
    "dev": "node scripts/dev.mjs",
    "test": "node --test 'test/*.test.mjs'"
  }
}
